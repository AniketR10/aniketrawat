# Google Form used by the "Send me a message" contact form (src/app/api/contact/route.ts).
# Find these by opening your Form's prefilled-link share option and inspecting the
# generated URL for each field's `entry.XXXXXXXXXX` id.
GOOGLE_FORM_LINK=your_google_form_prefilled_link
GOOGLE_FORM_FIELD_ID_NAME=entry_field_id
GOOGLE_FORM_FIELD_ID_EMAIL=entry_field_id
GOOGLE_FORM_FIELD_ID_MESSAGE=entry_field_id
GOOGLE_FORM_FIELD_ID_SOCIAL=entry_field_id

# Google Search Console verification token
NEXT_PUBLIC_GOOGLE_VERIFICATION=your_google_site_verification_token
